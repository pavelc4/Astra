PORT=3000
HOST=0.0.0.0

# Instagram cookies for GraphQL access (optional, fallback to snapsave)
# Cara dapetin:
#   1. Login Instagram di Chrome
#   2. F12 → Application → Cookies → instagram.com
#   3. Copy value "sessionid" dan "csrftoken"
#   4. Paste di bawah (encode URL otomatis)
INSTAGRAM_COOKIES="sessionid=123456%3Aabc123%3A12; csrftoken=xxx"
